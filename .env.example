# Any OpenAI-compatible endpoint works. Copy this file to .env and fill in your key.

# Groq (default)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b

# Other OpenAI-compatible providers (OpenAI, OpenRouter, Ollama, Gemini) should work by changing
# these three values, but only Groq was tested. Use a model that supports tool calling.
