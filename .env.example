# Any OpenAI-compatible endpoint works. Copy this file to .env and fill in your key.

# Groq (default)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b

# Gemini (tested). Free key from https://aistudio.google.com. To use it, put these three lines
# in a separate file such as .env.gemini and run with --env-file .env.gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_key_here
# LLM_MODEL=gemini-3.5-flash

# Other OpenAI-compatible providers (OpenAI, OpenRouter, Ollama) should work by changing
# these three values, but only Groq and Gemini were tested. Use a model that supports tool calling.
