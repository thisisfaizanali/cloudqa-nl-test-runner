# Any OpenAI-compatible endpoint works. Copy this file to .env and fill in your key.

# Groq (default)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b

# Gemini (uncomment these three and comment out the Groq ones to switch)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_key_here
# LLM_MODEL=gemini-2.5-flash
